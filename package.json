{
  "name": "hotel-offer-orchestrator",
  "version": "0.1.0",
  "private": true,
  "description": "Hotel Offer Orchestrator: aggregates hotel offers from suppliers via Temporal workflows",
  "license": "UNLICENSED",
  "main": "dist/api/server.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && npm run bundle:workflows",
    "bundle:workflows": "tsx scripts/bundle-workflows.ts",
    "start": "node dist/api/server.js",
    "start:worker": "node dist/temporal/worker.js",
    "dev": "tsx watch --env-file-if-exists=.env src/api/server.ts | pino-pretty",
    "dev:worker": "tsx watch --env-file-if-exists=.env src/temporal/worker.ts | pino-pretty",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest",
    "test:integration": "jest --config jest.integration.config.js"
  },
  "dependencies": {
    "@temporalio/activity": "1.24.0",
    "@temporalio/client": "1.24.0",
    "@temporalio/worker": "1.24.0",
    "@temporalio/workflow": "1.24.0",
    "express": "^5.3.0",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "redis": "^6.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@temporalio/testing": "1.24.0",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.19.2",
    "@types/supertest": "^7.2.1",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "jest": "^30.5.2",
    "pino-pretty": "^13.2.0",
    "prettier": "^3.9.10",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.15",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0"
  },
  "allowScripts": {
    "@parcel/watcher": false,
    "@swc/core": false,
    "esbuild": false,
    "fsevents": false,
    "protobufjs": false,
    "unrs-resolver": false
  },
  "overrides": {
    "test-exclude": "^8.0.0"
  }
}
